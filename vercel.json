{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/book", "destination": "/", "permanent": false },
    { "source": "/book/:path*", "destination": "/:path*", "permanent": false }
  ]
}
